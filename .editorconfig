root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,md}]
indent_size = 2

[database/original/*.sql]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
